{
  "info": {
    "_postman_id": "ed115f45-a4fd-4b08-be0a-e4d2e4ba19b3",
    "name": "Conduit Web App - API Testing",
    "description": "Koleksi pengujian API fungsional, negatif, otorisasi, dan boundary untuk Conduit RealWorld API (Release 1.0). Write request ke hosted API diblokir kecuali allowHostedWrites diaktifkan secara eksplisit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "53111465",
    "_collection_link": "https://go.postman.co/collection/53111465-ed115f45-a4fd-4b08-be0a-e4d2e4ba19b3?source=collection_link"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const baseUrl = pm.environment.get(\"baseUrl\") || \"\";",
          "const allowHostedWrites = pm.environment.get(\"allowHostedWrites\") === \"true\";",
          "const isHostedApi = /^https?:\\/\\/conduit-api\\.bondaracademy\\.com(?::\\d+)?(?:\\/|$)/i.test(baseUrl);",
          "const isWriteRequest = [\"POST\", \"PUT\", \"PATCH\", \"DELETE\"].includes(pm.request.method.toUpperCase());",
          "if (isHostedApi && isWriteRequest && !allowHostedWrites) {",
          "    console.error(\"Blocked write request to shared Conduit API. Set allowHostedWrites=true only with authorization.\");",
          "    pm.execution.skipRequest();",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "API-AUTH-001 - Registrasi Pengguna Baru (Positif)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const uniqueId = Date.now().toString().slice(-6);",
                  "pm.environment.set(\"user_username\", `qa_api_${uniqueId}`);",
                  "pm.environment.set(\"user_email\", `qa_api_${uniqueId}@test.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 atau 201 Created\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Respons memuat objek user dan token JWT\", function () {",
                  "    pm.expect(jsonData).to.have.property(\"user\");",
                  "    pm.expect(jsonData.user).to.have.property(\"token\");",
                  "    pm.expect(jsonData.user.token).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.environment.set(\"auth_token\", jsonData.user.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
